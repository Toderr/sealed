# USDC Mint on Devnet
NEXT_PUBLIC_USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU

# Deployed program ID on devnet
NEXT_PUBLIC_PROGRAM_ID=3WSjgWUKWhsENKJ1ibnbgvaiuQ8THJp4Mp7uGTUyeYeJ

# === Admin dashboard (read-only /admin) ===
# Access is granted if the connected wallet is in ADMIN_WALLETS, OR the request
# sends a passcode matching ADMIN_PASSCODE. Leave ADMIN_PASSCODE empty to disable
# the passcode path (wallet-only). Both are server-only (no NEXT_PUBLIC_ prefix).
ADMIN_WALLETS=
ADMIN_PASSCODE=
