# Solana RPC (get free key from https://dev.helius.xyz)
NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com

# === AI Agent — pick one ===

# Option 1: Anthropic direct
ANTHROPIC_API_KEY=

# Option 2: OpenRouter (if set, this takes priority)
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=anthropic/claude-sonnet-4

# USDC Mint on Devnet
NEXT_PUBLIC_USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU

# Deployed program ID on devnet
NEXT_PUBLIC_PROGRAM_ID=3WSjgWUKWhsENKJ1ibnbgvaiuQ8THJp4Mp7uGTUyeYeJ

# === Admin dashboard (read-only /admin) ===
# Access is granted if the connected wallet is in ADMIN_WALLETS, OR the request
# sends a passcode matching ADMIN_PASSCODE. Leave ADMIN_PASSCODE empty to disable
# the passcode path (wallet-only). Both are server-only (no NEXT_PUBLIC_ prefix).
ADMIN_WALLETS=
ADMIN_PASSCODE=

# === "Coming soon" feature flags ===
# Built-but-not-GA features. Default OFF (rendered as a disabled "Coming soon"
# state). Set to "true" to enable — e.g. on in staging, off in production.
NEXT_PUBLIC_FEATURE_X402=            # x402 pay-as-you-go LLM billing
NEXT_PUBLIC_FEATURE_GET_VERIFIED=    # paid identity verification ("Get verified")
# Standalone "chat with the agent" surfaces. Off = the Agent nav tab is hidden
# and agent setup lives under Profile → Settings. Does NOT affect the New Deal
# composer — deal creation stays available regardless of this flag.
NEXT_PUBLIC_FEATURE_AGENT_CHAT=      # standalone agent chat entry points
